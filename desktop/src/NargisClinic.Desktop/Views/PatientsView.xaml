<UserControl x:Class="NargisClinic.Desktop.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NargisClinic.Desktop.Localization">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource SectionTitle}"
                 Text="{Binding [patients_title], Source={x:Static loc:Strings.Instance}}" />
      <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center"
                 Text="{Binding CountText}" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <TextBox x:Name="SearchBox" Style="{StaticResource FieldInput}"
               Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="{Binding [patients_search_placeholder], Source={x:Static loc:Strings.Instance}}"
                 Foreground="{StaticResource MutedBrush}" Margin="14,0"
                 VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Rows}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{Binding [col_number], Source={x:Static loc:Strings.Instance}}" Binding="{Binding Number}" Width="130" />
          <DataGridTextColumn Header="{Binding [col_name], Source={x:Static loc:Strings.Instance}}" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="{Binding [col_phone], Source={x:Static loc:Strings.Instance}}" Binding="{Binding Phone}" Width="150" />
          <DataGridTextColumn Header="{Binding [col_age], Source={x:Static loc:Strings.Instance}}" Binding="{Binding Age}" Width="90" />
          <DataGridTextColumn Header="{Binding [col_balance], Source={x:Static loc:Strings.Instance}}" Binding="{Binding Balance}" Width="150" />
          <DataGridTextColumn Header="{Binding [col_status], Source={x:Static loc:Strings.Instance}}" Binding="{Binding Status}" Width="110" />
          <DataGridTextColumn Header="{Binding [col_last_visit], Source={x:Static loc:Strings.Instance}}" Binding="{Binding LastVisit}" Width="150" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="{Binding [loading], Source={x:Static loc:Strings.Instance}}"
                 Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="{Binding [patients_empty], Source={x:Static loc:Strings.Instance}}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   TextAlignment="Center" MaxWidth="520" />
        <Button Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Center"
                Content="{Binding [retry], Source={x:Static loc:Strings.Instance}}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
      <Button Style="{StaticResource GhostButton}" Margin="0,0,12,0" Width="120"
              Content="{Binding [previous], Source={x:Static loc:Strings.Instance}}"
              Command="{Binding PreviousCommand}" />
      <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,12,0" />
      <Button Style="{StaticResource GhostButton}" Width="120"
              Content="{Binding [next], Source={x:Static loc:Strings.Instance}}"
              Command="{Binding NextCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
