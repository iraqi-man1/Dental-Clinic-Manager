<UserControl x:Class="NargisClinic.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="0,16,0,0" />
      <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
    </StackPanel>
  </Border>
</UserControl>
