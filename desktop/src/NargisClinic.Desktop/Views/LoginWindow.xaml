<Window x:Class="NargisClinic.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NargisClinic.Desktop.Localization"
        xmlns:conv="clr-namespace:NargisClinic.Desktop.Converters"
        Title="{Binding [app_name], Source={x:Static loc:Strings.Instance}}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI, Tahoma, Arial"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Strings.Instance}}">
  <Window.Resources>
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  </Window.Resources>

  <Border Style="{StaticResource Card}" Margin="28" Padding="32">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
          <TextBlock Text="ن" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                   Text="{Binding [app_name], Source={x:Static loc:Strings.Instance}}"
                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />

        <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                Content="{Binding [language_switch], Source={x:Static loc:Strings.Instance}}"
                Command="{Binding ToggleLanguageCommand}" />
      </Grid>

      <TextBlock Style="{StaticResource Heading}" Margin="0,28,0,0"
                 Text="{Binding [login_title], Source={x:Static loc:Strings.Instance}}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{Binding [login_subtitle], Source={x:Static loc:Strings.Instance}}" />

      <Border Margin="0,18,0,0" Padding="12" CornerRadius="10" Background="{StaticResource AccentBrush}"
              Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      </Border>

      <TextBlock Style="{StaticResource FieldLabel}"
                 Text="{Binding [email], Source={x:Static loc:Strings.Instance}}" />
      <TextBox Style="{StaticResource FieldInput}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Style="{StaticResource FieldLabel}"
                 Text="{Binding [password], Source={x:Static loc:Strings.Instance}}" />
      <PasswordBox x:Name="PasswordInput" Padding="12,10" FontSize="14" MinHeight="44"
                   VerticalContentAlignment="Center" PasswordChanged="PasswordInput_PasswordChanged" />

      <Border Margin="0,16,0,0" Padding="12" CornerRadius="10" Background="{StaticResource DangerBackgroundBrush}"
              Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
      </Border>

      <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" IsDefault="True"
              Content="{Binding SignInText}" Command="{Binding SignInCommand}" />
    </StackPanel>
  </Border>
</Window>
