<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NargisClinic.Desktop</RootNamespace>
    <AssemblyName>NargisClinic</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <!-- Lets the WPF project compile on Linux CI and dev containers. It has no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NargisClinic.Core\NargisClinic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="supabase.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
